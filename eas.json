{
  "cli": {
    "version": ">= 14.0.0"
  },
  "build": {
    "development": {
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --clean && node scripts/fix-dev-launcher.js",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "preview": {
      "distribution": "internal",
      "prebuildCommand": "npx expo prebuild --clean && node scripts/fix-dev-launcher.js",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    },
    "production": {
      "prebuildCommand": "npx expo prebuild --clean && node scripts/fix-dev-launcher.js",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "simulator": false
      }
    }
  },
  "submit": {
    "production": {}
  }
}
