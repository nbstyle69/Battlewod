{
  "expo": {
    "name": "AthleX",
    "slug": "TheHub",
    "version": "1.0.46",
    "orientation": "portrait",
    "icon": "./assets/athex-logo.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "scheme": "athlex",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.athlex.app",
      "icon": "./assets/athex-logo.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "AthleX utilise la caméra pour enregistrer tes performances.",
        "NSMicrophoneUsageDescription": "AthleX utilise le micro pour les vidéos de performance.",
        "NSPhotoLibraryUsageDescription": "AthleX accède à ta galerie pour soumettre tes vidéos.",
        "NSPhotoLibraryAddUsageDescription": "AthleX enregistre tes vidéos de performance dans ta galerie."
      },
      "buildNumber": "37"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/athex-logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_CAMERA",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE"
      ],
      "package": "com.athlex.app",
      "versionCode": 55,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "athlex.app",
              "pathPrefix": "/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "AthleX utilise la caméra pour enregistrer tes performances.",
          "microphonePermission": "AthleX utilise le micro pour les vidéos de performance.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AthleX accède à ta galerie pour sauvegarder tes vidéos.",
          "savePhotosPermission": "AthleX sauvegarde tes vidéos de performance."
        }
      ],
      "expo-notifications",
      "expo-av",
      "expo-screen-orientation",
      "./plugins/withNoDevLauncher",
      [
        "@sentry/react-native/expo",
        {
          "organization": "nbs-innovation",
          "project": "athlex-mobile"
        }
      ],
      "expo-asset",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "54f4c573-40f9-4b3a-a2dd-d2e93500482b"
      }
    },
    "owner": "nbstyle",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54f4c573-40f9-4b3a-a2dd-d2e93500482b"
    }
  }
}
