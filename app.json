{
  "expo": {
    "name": "AthleX",
    "slug": "TheHub",
    "version": "1.0.14",
    "orientation": "default",
    "icon": "./assets/logoapp.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nbstyle.athlex",
      "icon": "./assets/logoapp.png",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "AthleX utilise la caméra pour enregistrer tes performances.",
        "NSMicrophoneUsageDescription": "AthleX utilise le micro pour les vidéos de performance.",
        "NSPhotoLibraryUsageDescription": "AthleX accède à ta galerie pour soumettre tes vidéos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0F",
        "foregroundImage": "./assets/logoapp.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.athlex.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "AthleX utilise la caméra pour enregistrer tes performances.",
          "microphonePermission": "AthleX utilise le micro pour les vidéos de performance.",
          "recordAudioAndroid": true
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "AthleX accède à ta galerie pour sauvegarder tes vidéos.",
          "savePhotosPermission": "AthleX sauvegarde tes vidéos de performance."
        }
      ],
      "expo-notifications",
      "expo-av",
      "expo-screen-orientation",
      "./plugins/withNoDevLauncher",
      [
        "@sentry/react-native/expo",
        {
          "organization": "nbs-innovation",
          "project": "athlex-mobile",
          "android": {
            "autoUploadSourceMap": false
          },
          "ios": {
            "autoUploadSourceMap": false
          }
        }
      ],
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "54f4c573-40f9-4b3a-a2dd-d2e93500482b"
      }
    },
    "owner": "nbstyle",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/54f4c573-40f9-4b3a-a2dd-d2e93500482b"
    }
  }
}
