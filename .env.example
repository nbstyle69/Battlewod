EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# La feature IA (analyse de crédibilité des scores) tourne côté serveur via
# l'Edge Function `analyze-tournament-score`. La clé Anthropic ne doit JAMAIS
# être exposée au client : configure-la comme secret Supabase, pas ici.
#   supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token-here
EXPO_PUBLIC_GIPHY_KEY=your-giphy-api-key-here
# Google Maps (Android) — injecté via app.config.js, NE PAS mettre dans app.json
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Supabase service role (BO + API routes uniquement, jamais côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
