EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# EXPO_PUBLIC_ANTHROPIC_KEY=your-anthropic-key-here  # Désactivé — feature IA commentée dans BOTournamentScreen
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here
EXPO_PUBLIC_MIXPANEL_TOKEN=your-mixpanel-token-here
EXPO_PUBLIC_TENOR_KEY=your-tenor-api-key-here
# Google Maps (Android) — injecté via app.config.js, NE PAS mettre dans app.json
GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here
# Supabase service role (BO + API routes uniquement, jamais côté client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
